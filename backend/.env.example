MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fawn
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
