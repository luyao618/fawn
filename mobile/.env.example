# Local Android release-test signing credentials.
#
# Copy this file to `mobile/.env` and fill in real values. The .env file is
# git-ignored (see mobile/.gitignore -> `.env*.local` plus the explicit entry
# below). NEVER commit a real keystore (`*.jks` is also git-ignored).
#
# Generate a personal/test keystore once with:
#   keytool -genkeypair -v -storetype JKS \
#     -keystore $HOME/.fawn/fawn-test.jks \
#     -alias fawn-test -keyalg RSA -keysize 2048 -validity 10000
#
# Then point these vars at it.

FAWN_ANDROID_KEYSTORE_PATH=/absolute/path/to/fawn-test.jks
FAWN_ANDROID_KEYSTORE_PASSWORD=replace-me
FAWN_ANDROID_KEY_ALIAS=fawn-test
FAWN_ANDROID_KEY_PASSWORD=replace-me
