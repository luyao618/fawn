{
  "expo": {
    "name": "鹿小宝",
    "slug": "fawn",
    "version": "2.3.2",
    "orientation": "portrait",
    "icon": "./assets/fawn-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fawn-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#6B3E1F"
    },
    "android": {
      "package": "com.luyao618.fawn",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fawn-adaptive-foreground.png",
        "backgroundImage": "./assets/fawn-adaptive-background.png",
        "backgroundColor": "#6B3E1F",
        "monochromeImage": "./assets/fawn-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.luyao618.fawn.local",
      "appleTeamId": "MQGR7A6V5C",
      "buildNumber": "10",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "鹿小宝需要使用相机，用于拍摄宝宝照片并上传到家庭相册。",
        "NSPhotoLibraryUsageDescription": "鹿小宝需要访问相册，用于选择宝宝照片并上传到家庭相册。",
        "NSMicrophoneUsageDescription": "鹿小宝需要使用麦克风，用于录制语音消息并识别成聊天文字。"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "./plugins/withAndroidNotifications",
        {
          "color": "#2c7a4b"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "鹿小宝需要访问相册，用于选择宝宝照片并上传到家庭相册。",
          "cameraPermission": "鹿小宝需要使用相机，用于拍摄宝宝照片并上传到家庭相册。",
          "microphonePermission": "鹿小宝需要使用麦克风，用于录制语音消息并识别成聊天文字。"
        }
      ],
      "expo-font",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "鹿小宝需要使用麦克风，用于录制语音消息并识别成聊天文字。"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#2c7a4b",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "950d40e4-ccb4-4bae-9d0c-fb9f9237c0e2"
      },
      "apiBaseUrl": "https://lumingchuan.vip/api"
    },
    "owner": "luyao618"
  }
}
