{
  "expo": {
    "name": "Fawn",
    "slug": "fawn",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/fawn-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.luyao618.fawn",
      "versionCode": 3,
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fawn-adaptive-foreground.png",
        "backgroundColor": "#6B3E1F",
        "monochromeImage": "./assets/fawn-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2c7a4b"
        }
      ],
      "expo-font",
      "./plugins/withAndroidReleaseSigning"
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#2c7a4b",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "apiBaseUrl": "https://lumingchuan.vip/api"
    }
  }
}
