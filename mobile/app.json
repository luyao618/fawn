{
  "expo": {
    "name": "鹿小宝",
    "slug": "fawn",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/fawn-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fawn-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#6B3E1F"
    },
    "android": {
      "package": "com.luyao618.fawn",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fawn-adaptive-foreground.png",
        "backgroundImage": "./assets/fawn-adaptive-background.png",
        "backgroundColor": "#6B3E1F",
        "monochromeImage": "./assets/fawn-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2c7a4b"
        }
      ],
      "expo-font",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "用于语音输入聊天消息"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#2c7a4b",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "950d40e4-ccb4-4bae-9d0c-fb9f9237c0e2"
      },
      "apiBaseUrl": "https://lumingchuan.vip/api"
    },
    "owner": "luyao618"
  }
}
